# Copiez ce fichier en ".env" et remplissez avec vos vraies valeurs.
# Ne JAMAIS commiter le fichier ".env" (mot de passe/cles secretes dedans).

# Depuis Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_ici

# Cle secrete pour signer les sessions admin (dashboard)
# Generez-en une longue et aleatoire, par exemple avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_moi_par_une_chaine_aleatoire_longue

# Port du serveur
PORT=4000

# URL(s) autorisee(s) a appeler cette API (votre site en production + en local)
ALLOWED_ORIGINS=http://localhost:5500,https://votre-site.netlify.app
