# Copiez ce fichier en ".env" et remplissez avec vos vraies valeurs.
# Ne JAMAIS commiter le fichier ".env" (mot de passe et cles secretes dedans).
# Sur Render, ces memes variables se saisissent dans Environment.

# --- Obligatoire -----------------------------------------------------------
# Depuis Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_ici

# Cle secrete pour signer les sessions de l'administration.
# Generez-en une longue et aleatoire, par exemple avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_moi_par_une_chaine_aleatoire_longue

# Adresses autorisees a appeler cette API (site en ligne + tests en local)
ALLOWED_ORIGINS=https://porte-folio-st-phane.vercel.app,http://localhost:5500

# Port du serveur (Render le fournit tout seul)
PORT=4000

# --- Images ----------------------------------------------------------------
# Bucket Supabase Storage qui recoit les images (cree par sql/mise-a-jour-2026-11.sql)
SUPABASE_BUCKET=portfolio

# --- Alertes des nouveaux messages (facultatif) ----------------------------
# Cle d'API Resend (resend.com > API Keys). Sans elle, aucune alerte n'est envoyee.
RESEND_API_KEY=
# Adresse qui recoit les alertes. Sans domaine verifie chez Resend,
# mettez l'adresse avec laquelle vous avez cree le compte Resend.
ALERT_EMAIL_TO=Emmanuelmande263@gmail.com
# Expediteur. A laisser tel quel tant qu'aucun domaine n'est verifie chez Resend.
ALERT_EMAIL_FROM=Portfolio <onboarding@resend.dev>
# Lien vers l'administration, ajoute dans l'e-mail
ADMIN_URL=https://porte-folio-st-phane.vercel.app/admin.html
